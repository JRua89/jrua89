{
  "id": "/",
  "name": "John Rua | Full Stack Developer",
  "short_name": "John Rua",
  "description": "John Rua is a full stack developer and Lead Developer at Kingsborough Community College, with 10+ years building PHP and JavaScript systems that scale.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#f5f5f5",
  "theme_color": "#f5f5f5",
  "lang": "en-US",
  "dir": "ltr",
  "categories": ["business", "productivity", "portfolio"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/favicon-16x16.png",
      "sizes": "16x16",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favicon-32x32.png",
      "sizes": "32x32",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/maskable-icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/desktop-1280x800.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
