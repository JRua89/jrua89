    },
    {
      "src": "/screenshots/mobile-412x915.png",
      "sizes": "412x915",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "John Rua's portfolio homepage on mobile"
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "handle_links": "preferred",
  "edge_side_panel": {
    "preferred_width": 480
  },
