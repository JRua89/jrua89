rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Push subscriptions are written and read only by the Cloud Functions,
    // which use the Admin SDK and bypass these rules entirely. No client
    // should ever touch this collection directly — a subscription endpoint
    // is effectively a capability to send someone notifications.
    match /pushSubscriptions/{doc} {
      allow read, write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
